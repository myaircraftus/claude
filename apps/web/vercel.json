{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile=false",
  "buildCommand": "cd ../.. && pnpm --filter @myaircraft/web build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/heal-ingestions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/integrations/adsb/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/wo-audit",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/maintenance-predictions",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/trash-purge",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/airbly-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/fsp-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/telemetry-inference",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/extract-receipts-sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/vision-dispatch-sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/vision-fallback-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/vision-batch-trigger",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/support-triage",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/health-alerts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/churn-signals",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/email-queue-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/invoices/reminders/send",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/support-kb-curator",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/ocr-date-sanitiser",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/tach-time-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/cron-health",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/cert-expiry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/churn-risk",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/failed-login-anomaly",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cost-anomaly",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/duplicate-docs",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/sop-coverage-gap",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/tail-number-validator",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/shift-summary",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/pii-leak-scanner",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/stripe-failed-charges",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/trial-conversion-coach",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/ad-reference-extractor",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/deployment-canary",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/clock-anomaly",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/audit-event-watchdog",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/aircraft-year-backfill",
      "schedule": "0 5 * * 0"
    },
    {
      "path": "/api/cron/review-request-timer",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/dpa-anniversary",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/rerank-cache-warmer",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/error-rate-sentinel",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/soc2-evidence",
      "schedule": "0 0 1 */3 *"
    },
    {
      "path": "/api/cron/iso-evidence",
      "schedule": "30 0 1 */3 *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/documents/(.*)/preview",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
